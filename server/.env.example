# Copy to .env and fill in. Never commit .env.
PORT=4400
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shiftline
JWT_SECRET=change-me-to-a-long-random-string
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# The chat works without signing in unless you set this to false.
# (Writing to the shared database always needs a supervisor sign-in.)
AI_PUBLIC=true

# First supervisor account, created on startup if no users exist.
ADMIN_EMAIL=supervisor@example.com
ADMIN_PASSWORD=change-me

# Comma-separated origins allowed to call the API (the Vercel URL + localhost).
CORS_ORIGINS=http://localhost:5173,https://shiftline.vercel.app
